{
  "name": "tmis-workbench",
  "productName": "TMIS Workbench",
  "version": "6.2.0",
  "private": true,
  "description": "Offline TMIS report download workbench",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/build.cjs --serve",
    "build": "tsc --noEmit && node scripts/build.cjs",
    "start": "electron .",
    "install:runtime": "install-electron",
    "test": "node --test electron/*.test.cjs",
    "smoke": "node scripts/smoke.cjs",
    "smoke:workspaces": "node scripts/workspaces-smoke.cjs",
    "test:soak": "node scripts/stability-soak.cjs"
  },
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "lucide-react": "0.577.0"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.28.1",
    "electron": "44.4.1",
    "typescript": "https://registry.npmjs.org/typescript/-/typescript-5.9.3.tgz"
  }
}
